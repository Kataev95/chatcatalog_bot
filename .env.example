BOT_TOKEN=123456:ABC...
# ID админов через запятую (узнать свой ID: @userinfobot)
ADMINS=111111111
# Пускать в каталог каналы (true) или только группы (false)
ALLOW_CHANNELS=true
# Каналы-источники: если бот админ в них, новые посты импортируются сами (@name через запятую)
SOURCE_CHANNELS=
DB_PATH=catalog.db

# Закрепление в топе за звёзды: дней:звёзд через запятую
PIN_PLANS=1:50,7:250,30:750
